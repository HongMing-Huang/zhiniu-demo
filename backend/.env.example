# 知牛 LLM 多模型网关 - 配置示例
# 复制为 .env 并填入真实 Key（Key 只存在于服务端，绝不提交 git）

# ===== 厂商 Key（真实端点，2026-08-22 官方核实）=====
# DeepSeek:    https://api.deepseek.com/chat/completions  (Bearer)
DEEPSEEK_API_KEY=
# GLM/智谱:    https://open.bigmodel.cn/api/paas/v4        (Bearer)
ZHIPUAI_API_KEY=
# 腾讯混元:    https://api.hunyuan.cloud.tencent.com/v1   (Bearer)
HUNYUAN_API_KEY=

# ===== 网关自身鉴权（客户端请求时带给网关注入即可）=====
GATEWAY_API_KEY=changeme

# 网关监听地址
HOST=0.0.0.0
PORT=8000